<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <DebugType>embedded</DebugType>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <NeutralLanguage>en-US</NeutralLanguage>
    <!-- #3: ship XML docs next to each .dll in the nupkg. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup Label="Tamp package metadata defaults">
    <Authors>Scott Singleton</Authors>
    <Company>Tamp Project</Company>
    <Copyright>Copyright (c) 2026 Scott Singleton</Copyright>
    <PackageProjectUrl>https://github.com/tamp-build/tamp-spfx</PackageProjectUrl>
    <RepositoryUrl>https://github.com/tamp-build/tamp-spfx</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>tamp;build;automation;ci;dotnet;spfx;sharepoint;sppkg;heft;m365;security</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <PropertyGroup Label="Tamp.Core dependency mode">
    <TampCoreMode Condition="'$(TampCoreMode)' == ''">project</TampCoreMode>
    <TampCorePath Condition="'$(TampCorePath)' == ''">$(MSBuildThisFileDirectory)..\tamp\src\Tamp.Core\Tamp.Core.csproj</TampCorePath>
    <TampSarifPath Condition="'$(TampSarifPath)' == ''">$(MSBuildThisFileDirectory)..\tamp\src\Tamp.Sarif\Tamp.Sarif.csproj</TampSarifPath>
  </PropertyGroup>

  <!--
    Tamp.Heft.V1 is a sibling satellite with its own release cadence, so it gets its own switch.
    `project` builds against a ..\tamp-heft clone (inner loop, and CI until a Heft release exists);
    `package` uses the published NuGet package (release builds). Defaults to TampCoreMode.
  -->
  <PropertyGroup Label="Tamp.Heft dependency mode">
    <TampHeftMode Condition="'$(TampHeftMode)' == ''">$(TampCoreMode)</TampHeftMode>
    <TampHeftPath Condition="'$(TampHeftPath)' == ''">$(MSBuildThisFileDirectory)..\tamp-heft\src\Tamp.Heft.V1\Tamp.Heft.V1.csproj</TampHeftPath>
  </PropertyGroup>

  <PropertyGroup Label="Tamp central version">
    <Version>0.1.0</Version>
  </PropertyGroup>

</Project>
